#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/netcontrol/netcontrol /usr/bin/netcontrol

	# Ребрендинг - без этого система тем GTK кэширует СТАРУЮ иконку даже
	# после подмены файла (иконка в заголовке окна берётся именно из
	# gtk-кэша, см. flutter/linux/my_application.cc - gtk_icon_theme_load_icon).
	gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true

	# Убираем службу прежнего имени, если машина обновляется с версии,
	# которая ставилась как rustdesk.
	if [ -e /etc/systemd/system/rustdesk.service ] || [ -e /usr/lib/systemd/system/rustdesk.service ]; then
		systemctl stop rustdesk >/dev/null 2>&1 || true
		systemctl disable rustdesk >/dev/null 2>&1 || true
		rm -f /etc/systemd/system/rustdesk.service /usr/lib/systemd/system/rustdesk.service /usr/lib/systemd/user/rustdesk.service >/dev/null 2>&1 || true
	fi

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/netcontrol.service ]; then
			rm /etc/systemd/system/netcontrol.service /usr/lib/systemd/system/netcontrol.service /usr/lib/systemd/user/netcontrol.service >/dev/null 2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/netcontrol/files/systemd/netcontrol.service /usr/lib/systemd/system/netcontrol.service
		# Обход ошибки в Ubuntu 18.04: "Executable path is not absolute" для
		# ExecStop с голым pkill.
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/netcontrol.service
		fi
		systemctl daemon-reload
		systemctl enable netcontrol
		systemctl start netcontrol
	fi
fi
